# OAuth da conta Google do Dono. Sem estes valores o app sobe
# com o Calendário de demonstração (somente leitura).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# Origem canônica pública (sem path). Equivale ao NEXTAUTH_URL de apps
# NextAuth — este projeto não usa NextAuth; APP_ORIGIN é o nome nosso.
# Production (Vercel → Environment: Production):
#   APP_ORIGIN=https://agendainteligente.net.br
#   NEXT_PUBLIC_APP_ORIGIN=https://agendainteligente.net.br
# Preview e local: deixe vazio.
# APP_ORIGIN=
# NEXT_PUBLIC_APP_ORIGIN=
# NEXTAUTH_URL=   # aceito só como alias de APP_ORIGIN, se alguém colar o nome antigo
#
# Redirect URI do OAuth. Só é lida se estiver preenchida, e TEM de ser deste host.
# Se vazia, o app usa a origem do pedido + /api/auth/google/callback.
#
# Production:
#   GOOGLE_REDIRECT_URI=https://agendainteligente.net.br/api/auth/google/callback
#
# Preview (Vercel → Environment: Preview):
#   NÃO defina GOOGLE_REDIRECT_URI (ou deixe vazio). NÃO copie a URI de produção.
#   O app usa https://<host-deste-preview>/api/auth/google/callback.
#   Para o login funcionar, cadastre ESSA URI EXATA no Google Cloud.
#
# Local:
#   GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# GOOGLE_REDIRECT_URI=
#
# E-mail público de contato (homepage, /privacidade, /termos). O padrão está
# na constante CONTATO_EMAIL em src/lib/contato.ts
# (niltonrdonascimento@gmail.com). Só defina isto para sobrescrever.
# NEXT_PUBLIC_CONTATO_EMAIL=
#
# Redirect opt-in do host de produção *.vercel.app para APP_ORIGIN, só nas
# páginas públicas GET (/, /privacidade, /termos). Não mexe em /api/* nem
# em /conversa, para não quebrar OAuth nem preview. Ligar só depois do
# domínio novo estar no ar. Preferível: redirect no painel da Vercel.
# REDIRECT_VERCEL_PARA_CANONICO=1
#
# Obrigatório em produção. Chave de cifra AES-256-GCM da sessão e da
# proposta pendente. NÃO reutilize o GOOGLE_CLIENT_SECRET.
# Mínimo 32 caracteres. Gerar: openssl rand -base64 32
GOOGLE_TOKEN_SECRET=
