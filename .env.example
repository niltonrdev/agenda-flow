# OAuth da conta Google do Dono. Sem estes valores o app sobe
# com o Calendário em memória (demonstração e suíte automática).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# Redirect URI. Só é lida se estiver preenchida, e TEM de ser deste host.
#
# Production (Vercel → Environment: Production):
#   GOOGLE_REDIRECT_URI=https://agenda-flow-mu.vercel.app/api/auth/google/callback
#   (Se vazio, o app usa a origem do pedido + /api/auth/google/callback.)
#
# Preview (Vercel → Environment: Preview):
#   NÃO defina GOOGLE_REDIRECT_URI (ou deixe vazio). NÃO copie a URI de produção.
#   O app usa https://<host-deste-preview>/api/auth/google/callback.
#   Para o login funcionar, cadastre ESSA URI EXATA no Google Cloud.
#
# Local:
#   GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# GOOGLE_REDIRECT_URI=
#
# Opcional; se vazio, usa GOOGLE_CLIENT_SECRET para assinar o cookie da sessão
GOOGLE_TOKEN_SECRET=
