# OAuth da conta Google do Dono. Sem estes valores o app sobe
# com o Calendário em memória (demonstração e suíte automática).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# Redirect URI. Obrigatório ser o callback DESTE host.
# Produção (Vercel → Environment: Production):
#   GOOGLE_REDIRECT_URI=https://agenda-flow-mu.vercel.app/api/auth/google/callback
# Preview: NÃO copie a URI de produção. Ou deixe vazio (o app recusa o
# login no preview) ou cadastre no Google Cloud a URI exata do host:
#   https://agenda-flow-git-<branch>-nilteras-projects.vercel.app/api/auth/google/callback
# Local:
#   GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# GOOGLE_REDIRECT_URI=
#
# Opcional; se vazio, usa GOOGLE_CLIENT_SECRET para assinar o cookie da sessão
GOOGLE_TOKEN_SECRET=
