# OAuth da conta Google do Dono. Sem estes valores o app sobe
# com o Calendário de demonstração (somente leitura).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional. Se omitir ou deixar vazio, usa <origem>/api/auth/google/callback
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
#
# Obrigatório em produção. Chave de cifra AES-256-GCM da sessão e da
# proposta pendente. NÃO reutilize o GOOGLE_CLIENT_SECRET.
# Gerar: openssl rand -base64 32
GOOGLE_TOKEN_SECRET=
